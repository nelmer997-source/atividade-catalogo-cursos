<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- 1. Criar tabela instrutor e 4. Restrição única de email -->
    <changeSet id="1" author="nicolas">
        <createTable tableName="instrutor">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="nome" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(160)">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>
    </changeSet>

    <!-- 2. Criar tabela curso -->
    <changeSet id="2" author="nicolas">
        <createTable tableName="curso">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="titulo" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="carga_horaria" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="nivel" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="instrutor_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- 3. Adicionar chave estrangeira -->
    <changeSet id="3" author="nicolas">
        <addForeignKeyConstraint baseTableName="curso" baseColumnNames="instrutor_id"
                                 constraintName="fk_curso_instrutor"
                                 referencedTableName="instrutor"
                                 referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>